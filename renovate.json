{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>serl/renovate-config"],
  "packageRules": [
    {
      "description": "We update these packages manually",
      "matchPackageNames": ["django", "postgres"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Builder ref doubles as the ghcr image tag; SHA/2026.06.0 image tags don't exist",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/builder"],
      "pinDigests": false,
      "allowedVersions": "!/^2026\\.06\\.0$/"
    }
  ]
}
