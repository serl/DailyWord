{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>serl/renovate-config"],
  "packageRules": [
    {
      "description": "We update these packages manually",
      "matchPackageNames": ["django", "postgres"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Builder needs to be updated manually",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/builder"],
      "enabled": false
    }
  ]
}
